# Copie este arquivo para .streamlit/secrets.toml para rodar localmente
# (esse arquivo real nunca é commitado — está no .gitignore).
#
# No Streamlit Community Cloud, esses valores vão em:
# App > Settings > Secrets (não em arquivo nenhum do repositório).

# Senha do usuário "admin" criado automaticamente na primeira execução
# (só é usada se ainda não existir nenhum usuário). Troque pela tela de
# Usuários assim que logar pela primeira vez.
ADMIN_SENHA_PADRAO = "defina-uma-senha-forte-aqui"

# Conexão com o banco Supabase que guarda os dados em produção (ver
# GUIA_DEPLOY.md e supabase_setup.sql para o passo a passo completo). SEM
# essas duas linhas, o sistema roda 100% local em data/*.csv — é assim que
# continua funcionando no seu computador.
#
# SUPABASE_URL: Project Settings > Data API > "Project URL"
# SUPABASE_KEY: Project Settings > Data API > "service_role" (NÃO a "anon
#   public" — a service_role dá acesso total, sem precisar configurar Row
#   Level Security; por isso nunca pode vazar/ir pro código, só em secrets).
SUPABASE_URL = "https://SEU-PROJETO.supabase.co"
SUPABASE_KEY = "sua-chave-service-role-aqui"
